{
    "llm_model_name_or_path": "./llm_config/did/",
    "dataset_path": "./dataset/represented_data/tuneidx/tuneidx_Pop909/did8",
    "metadata_path": "./dataset/metadata/Pop909_metadata.json",
    "output_dir": "./weights/did_Pop909_tiny_acc",
    "vocab_file_path": "./vocab/vocab_Pop909/vocab_Pop909_did8.json",
    "max_seq_length": 256,
    "gpu_devices": "0",
    "pos_features": [
        "bar",
        "time_signature",
        "all_instruments"
    ],
    "note_features": [
        "type",
        "chord",
        "beat",
        "tempo",
        "instrument",
        "pitch",
        "duration",
        "velocity"
    ],
    "task_mode": "accompaniment",
    "condition_instrument_prefix": [
        "Instrument_0"
    ],
    "use_bridge": true,
    "condition_encoder_layers": 2,
    "condition_encoder_heads": 6,
    "condition_cross_attention_heads": 6,
    "time_decoder_layers": 5,
    "time_decoder_hidden_size": 384,
    "time_decoder_attention_heads": 6,
    "time_decoder_intermediate_size": 1536,
    "note_decoder_layers": 5,
    "note_decoder_hidden_size": 384,
    "note_decoder_attention_heads": 6,
    "note_decoder_intermediate_size": 1536,
    "bar_encoder_layers": 2,
    "bar_encoder_heads": 6,
    "pos_proj_dim": 384,
    "note_proj_dim": 384,
    "bar_embedding_dim": 96,
    "type_embedding_dim": 192,
    "beat_embedding_dim": 64,
    "time_signature_embedding_dim": 48,
    "tempo_embedding_dim": 48,
    "chord_embedding_dim": 96,
    "instrument_embedding_dim": 48,
    "pitch_embedding_dim": 224,
    "duration_embedding_dim": 48,
    "velocity_embedding_dim": 32,
    "num_train_epochs": 150,
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0002,
    "weight_decay": 0.1,
    "logging_steps": 25,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.1,
    "bf16": true,
    "save_strategy": "epoch",
    "evaluation_strategy": "no",
    "max_grad_norm": 1.0,
    "remove_unused_columns": false,
    "dataloader_num_workers": 8,
    "save_total_limit": 32,
    "load_best_model_at_end": false,
    "metric_for_best_model": "eval_loss",
    "greater_is_better": false,
    "report_to": "tensorboard",
    "save_safetensors": false,
    "use_augmentation": true,
    "use_harmonic_plan": false,
    "in_beat_resolution": 4
}
